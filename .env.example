# BackOnTrack Frontend — Environment Variables
# Copy this file to .env.local or .env

# Node.js version
NODE_VERSION=22.16.0

# Application URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend API Base URL
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api

# Mode: 'true' uses typed client-side mock data; 'false' connects to real HTTP backend
NEXT_PUBLIC_DEMO_MODE=true
